# Sheggar Wheels - Environment Configuration Template
# Copy this file to .env.local and populate with your local or Supabase project keys.
# NEVER commit .env.local or expose service-role keys to client components.

# -----------------------------------------------------------------------------
# Supabase Public Configuration (Accessible in browser & server)
# -----------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://your-project-id.supabase.co or http://127.0.0.1:54321 for local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Publishable Key (Safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# -----------------------------------------------------------------------------
# Supabase Server-Only Configuration (NEVER expose to browser / NEXT_PUBLIC)
# -----------------------------------------------------------------------------
# Service Role Secret Key (Bypasses RLS - only for trusted administrative server scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-do-not-expose-to-browser

# Optional: Application Base URL for canonical links and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
